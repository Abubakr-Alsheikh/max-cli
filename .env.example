# ==========================================
# MAX CLI CONFIGURATION
# ==========================================

# --- General Settings ---
# Default quality for image/pdf compression (0-100)
DEFAULT_QUALITY=80


# ==========================================
# AI PROVIDER SETUP
# ==========================================

# --- OPTION 1: OpenAI (Default) ---
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# --- OPTION 2: Google Gemini (Free Tier Available) ---
# Get key from: https://aistudio.google.com/
# 1. Set your Google API Key here:
# OPENAI_API_KEY=AIzaSy...
#
# 2. Set the Compatibility Base URL (Required for Gemini):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Model Selection ---

# Logic & Chat Model (Text/Vision)
# OpenAI: 'gpt-5', 'gpt-5-nano'
# Gemini: 'gemini-3-flash', 'gemini-3-pro'
AI_MODEL=gpt-5-nano

# Dedicated Image Generation Model
# OpenAI: 'gpt-image-1-mini' or 'gpt-image-1.5'
# Gemini: 'gemini-2.5-flash-image' or 'gemini-3-pro-image-preview'
AI_IMAGE_MODEL=gpt-image-1-mini
